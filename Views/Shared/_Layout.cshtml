<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/assets/toyota-logo.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Font Awesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @* <img src="https://freepngimg.com/thumb/toyota_logo/5-2-toyota-logo-png-thumb.png" width="30" height="30" style="margin-right: 10px" /> *@
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><b>CyberAwareness.org</b></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Home nav item -->
                        <li class="nav-item">
                            <i class="fas fa-home"></i>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <!-- News nav item -->
                        <li class="nav-item">
                            <i class="fas fa-newspaper"></i>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Vehicles" asp-action="Index">News</a>
                        </li>
                        <!-- Password Check nav item -->
                        <li class="nav-item">
                            <i class="fas fa-key"></i>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Match" asp-action="FindYourMatch">Check Password Strength</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 ZML Toyota - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    /* Footer styling */
    footer {
        background-color: #fff; /* Make the footer white */
        padding: 10px 20px;
        position: relative;
        text-align: center;
        color: #333;

        a {
            color: #007bff;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    }
</style>